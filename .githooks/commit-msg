#!/bin/sh
# 커밋 메시지 형식 검사: `유형: 한국어 제목 (#이슈번호)`
set -eu

msg_file="$1"
first_line="$(sed -n '1p' "$msg_file")"

if grep -i '^Co-Authored-By:' "$msg_file" >/dev/null; then
  echo "커밋 거부: Co-Authored-By 줄은 넣지 않는다." >&2
  exit 1
fi

if ! printf '%s' "$first_line" | grep -E '^(feat|fix|docs|refactor|test|chore|style|perf|data|exp): .+$' >/dev/null; then
  echo "커밋 거부: 첫 줄은 '유형: 제목' 형식이어야 한다. 유형은 feat fix docs refactor test chore style perf data exp 중 하나." >&2
  exit 1
fi

title="${first_line#*: }"
title_len="$(printf '%s' "$title" | LC_ALL=en_US.UTF-8 wc -m | tr -d ' ')"
if [ "$title_len" -gt 50 ]; then
  echo "커밋 거부: 제목은 50자 이하여야 한다 (지금 ${title_len}자)." >&2
  exit 1
fi

case "$first_line" in
  *.) echo "커밋 거부: 제목 끝에 마침표를 붙이지 않는다." >&2; exit 1 ;;
esac
