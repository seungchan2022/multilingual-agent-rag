#!/bin/sh
# main 직접 커밋 금지, 비밀값·과제 원문 파일 차단
set -eu

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [ "$branch" = "main" ]; then
  echo "커밋 거부: main에서 직접 커밋하지 않는다. 이슈 브랜치를 먼저 만든다 (git switch -c <이슈번호>-<이름>)." >&2
  exit 1
fi

# 한글 파일명이 따옴표와 8진수로 바뀌어 나오면 패턴이 맞지 않으므로 quotepath를 끈다
git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  case "$file" in
    .env.example) ;;
    *.pem|*.key|*.p12|*.cer|.env|.env.*|*.pages|.codex/assignment-requirements.md)
      echo "커밋 거부: 올리면 안 되는 파일이 stage되어 있다: $file" >&2
      exit 1
      ;;
  esac
done

# 문서 파일은 fetch.py와 build.py만 바꾼다. 파일만 바뀌고 해시가 그대로이면 손으로 고친 것으로 보고 막는다
if git -c core.quotepath=off diff --cached --name-only | grep -q '^data/corpus/'; then
  if ! uv run --quiet python src/corpus/check_staged.py; then
    echo "커밋 거부: data/corpus/의 파일이 collected.yaml의 해시와 다르다. 손으로 고친 파일이면 git restore로 되돌린다." >&2
    exit 1
  fi
fi
